{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "comments": "AI-SPM — Shadow AI Posture Management. Function App (Linux Consumption, Python) + Managed Identity + Storage. Bu template altyapıyı kurar; kod post-deploy 'func azure functionapp publish' ile yüklenir (Linux Consumption URL-tabanlı RUN_FROM_PACKAGE desteklemez). Post-deploy: scripts/postdeploy.sh kodu deploy eder ve MI'a Graph rollerini atar."
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "[concat('aispm-', uniqueString(resourceGroup().id))]",
      "metadata": { "description": "Function App adı (global benzersiz olmalı)." }
    },
    "tenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": { "description": "Taranacak Entra tenant ID." }
    },
    "scanSchedule": {
      "type": "string",
      "defaultValue": "0 0 6 * * *",
      "metadata": { "description": "NCRONTAB: sn dk saat gün ay haftagünü. Varsayılan her gün 06:00 UTC." }
    },
    "reportContainer": {
      "type": "string",
      "defaultValue": "aispm-reports",
      "metadata": { "description": "Raporların yazılacağı Blob container adı." }
    },
    "emailSchedule": {
      "type": "string",
      "defaultValue": "0 0 8 * * 1",
      "metadata": { "description": "Haftalık digest NCRONTAB. Varsayılan Pazartesi 08:00 UTC." }
    },
    "mailSender": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Digest gönderen mailbox (UPN). Boş bırakılırsa mail gönderilmez; portaldan doldurulabilir." }
    },
    "mailTo": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Digest alıcı(lar), virgülle ayrılmış. Portaldan doldurulabilir." }
    },
    "authClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Entra app registration (client) ID — Easy Auth için. Boşsa auth yapılandırılmaz (önce scripts/setup_entra_auth.sh çalıştırın)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure bölgesi." }
    }
  },
  "variables": {
    "storageName": "[toLower(concat('aispm', uniqueString(resourceGroup().id)))]",
    "planName": "[concat(parameters('appName'), '-plan')]",
    "storageId": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard_LRS" },
      "kind": "StorageV2",
      "properties": { "minimumTlsVersion": "TLS1_2", "allowBlobPublicAccess": false }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Y1", "tier": "Dynamic" },
      "kind": "functionapp",
      "properties": { "reserved": true }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[variables('storageId')]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "reserved": true,
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "Python|3.11",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            { "name": "FUNCTIONS_EXTENSION_VERSION", "value": "~4" },
            { "name": "FUNCTIONS_WORKER_RUNTIME", "value": "python" },
            { "name": "AzureWebJobsStorage", "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageName'), ';AccountKey=', listKeys(variables('storageId'), '2023-01-01').keys[0].value, ';EndpointSuffix=', environment().suffixes.storage)]" },
            { "name": "SCM_DO_BUILD_DURING_DEPLOYMENT", "value": "true" },
            { "name": "ENABLE_ORYX_BUILD", "value": "true" },
            { "name": "AISPM_TENANT_ID", "value": "[parameters('tenantId')]" },
            { "name": "SCAN_SCHEDULE", "value": "[parameters('scanSchedule')]" },
            { "name": "REPORT_CONTAINER", "value": "[parameters('reportContainer')]" },
            { "name": "EMAIL_SCHEDULE", "value": "[parameters('emailSchedule')]" },
            { "name": "AISPM_MAIL_SENDER", "value": "[parameters('mailSender')]" },
            { "name": "AISPM_MAIL_TO", "value": "[parameters('mailTo')]" },
            { "name": "AISPM_REPORT_URL", "value": "" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-01-01",
      "name": "[concat(parameters('appName'), '/authsettingsV2')]",
      "condition": "[not(empty(parameters('authClientId')))]",
      "dependsOn": [ "[resourceId('Microsoft.Web/sites', parameters('appName'))]" ],
      "properties": {
        "platform": { "enabled": true },
        "globalValidation": {
          "requireAuthentication": false,
          "unauthenticatedClientAction": "AllowAnonymous"
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "registration": {
              "openIdIssuer": "[concat(environment().authentication.loginEndpoint, subscription().tenantId, '/v2.0')]",
              "clientId": "[parameters('authClientId')]"
            },
            "validation": {
              "allowedAudiences": [ "[concat('api://', parameters('authClientId'))]" ]
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-01-01', 'Full').identity.principalId]"
    },
    "nextStep": {
      "type": "string",
      "value": "[concat('Post-deploy (Cloud Shell): git clone repo && ./scripts/postdeploy.sh ', resourceGroup().name, ' ', parameters('appName'))]"
    }
  }
}
